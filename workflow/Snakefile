rule station_energy_band_preparation:
    """Prepare the explicit ±25% fiscal-energy-band diagnostic sensitivity."""
    input:
        data=(
            BASE_NETWORK + LOADS + MODEL_DATA + EXTERNAL_BOUNDARY_DATA
            + [STATCAN_GENERATION, BC_HYDRO_STATION_EVIDENCE, BC_HYDRO_STATION_MAPPING]
        ),
        script="workflow/scripts/prepare_model_file.py",
    output:
        network=STATION_BAND_NETWORK_PREPARED,
        report=f"{STATION_BAND_DIR}/model_preparation.md",
    log:
        "logs/snakemake/station_energy_band_preparation.log"
    run:
        run_logged(
            [
                PYTHON, "-m", "workflow.scripts.prepare_model_file",
                "--network", output.network,
                "--report", output.report,
                "--year", str(config["execution"]["year"]),
                "--capacity-choice", config["execution"]["capacity_choice"],
                "--reservoir-representation", config["base_model"]["reservoir_representation"],
                "--water-policy", config["base_model"]["water_policy"],
                "--storage-policy", config["base_model"]["storage_policy"],
                "--external-boundary-policy", config["base_model"]["external_boundary_policy"],
                "--network-flow-formulation", config["base_model"]["network_flow_formulation"],
                "--generation-calibration-policy", config["base_model"]["generation_calibration_policy"],
                "--ror-dispatch-policy", config["base_model"]["ror_dispatch_policy"],
                "--hydro-dispatch-cost-policy", "source_generic_vom",
                "--observed-generation", STATCAN_GENERATION,
                "--named-station-capacity-policy", config["base_model"]["named_station_capacity_policy"],
                "--named-station-energy-policy", "bc_hydro_fiscal_2021_screening_band",
                "--named-station-energy-tolerance", "0.25",
                "--named-station-evidence", BC_HYDRO_STATION_EVIDENCE,
                "--named-station-mapping", BC_HYDRO_STATION_MAPPING,
                "--release-multiplier", str(config["base_model"]["release_multiplier"]),
            ],
            log[0],
        )


