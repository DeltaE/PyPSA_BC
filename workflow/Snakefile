rule solve_scenario:
    input:
        case=f"{SCENARIO_DIR}/{{case}}.yaml",
        data=BASE_NETWORK + LOADS + MODEL_DATA + EXTERNAL_BOUNDARY_DATA,
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation_gate="studies/chapter2/gate2/representation_verification.json",
        release_uncertainty_gate="studies/chapter2/gate2/release_uncertainty_verification.json",
        storage_uncertainty_gate="studies/chapter2/gate2/storage_uncertainty_verification.json",
        external_boundary_gate="studies/chapter2/gate2/external_boundary_verification.json",
        script="workflow/scripts/run_scenario.py",
    output:
        network=f"{RUN_DIR}/{{case}}/network.nc",
        report=f"{RUN_DIR}/{{case}}/build_model_report.md",
    log:
        f"logs/snakemake/solve_{{case}}.log"
    wildcard_constraints:
        case="|".join(re.escape(case_id) for case_id in RUNNABLE_CASE_IDS)
    run:
        run_configured_scenario(
            input.case,
            output.network,
            output.report,
            input.gate1,
            input.gate2,
            input.representation_gate,
            input.release_uncertainty_gate,
            input.storage_uncertainty_gate,
            input.external_boundary_gate,
            log[0],
        )


rule solve_all_implemented:
    input:
        expand(f"{RUN_DIR}/{{case}}/network.nc", case=RUNNABLE_CASE_IDS)


rule visual_report:
    input:
        network=f"{RUN_DIR}/{{case}}/network.nc",
        script="workflow/scripts/build_visual_report.py",
    output:
        f"{RUN_DIR}/{{case}}/vis/network_visual_report.html"
    log:
        f"logs/snakemake/report_{{case}}.log"
    wildcard_constraints:
        case="|".join(re.escape(case_id) for case_id in RUNNABLE_CASE_IDS)
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.build_visual_report", "--network", input.network,
             "--vis-dir", f"{RUN_DIR}/{wildcards.case}/vis"],
            log[0],
        )


rule reports_all_implemented:
    input:
        expand(
            f"{RUN_DIR}/{{case}}/vis/network_visual_report.html",
            case=RUNNABLE_CASE_IDS,
        )
