rule station_energy_band_solve:
    input:
        network=STATION_BAND_NETWORK_PREPARED,
        structural=f"{STATION_BAND_DIR}/network_structure.json",
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation="studies/chapter2/gate2/representation_verification.json",
        release="studies/chapter2/gate2/release_uncertainty_verification.json",
        storage="studies/chapter2/gate2/storage_uncertainty_verification.json",
        boundary="studies/chapter2/gate2/external_boundary_verification.json",
        script="workflow/scripts/solve_model.py",
    output:
        network=STATION_BAND_NETWORK_SOLVED,
        summary=STATION_BAND_SOLVE_SUMMARY,
    log:
        "logs/snakemake/station_energy_band_solve.log"
    run:
        if not config["execution"]["allow_solve"]:
            raise RuntimeError(
                "Station-band sensitivity solve is disabled; set execution.allow_solve "
                "to true only after reviewing its cross-period evidence boundary."
            )
        for gate_file in (
            input.structural, input.gate1, input.gate2, input.representation,
            input.release, input.storage, input.boundary,
        ):
            require_validation_pass(gate_file, "Station-band sensitivity prerequisite")
        run_logged(
            [
                PYTHON, "-m", "workflow.scripts.solve_model",
                "--network", input.network,
                "--output", output.network,
                "--summary", output.summary,
                "--highs-method", "simplex",
                "--time-limit-seconds", "1200",
            ],
            log[0],
        )


