"""Non-invasive Snakemake orchestration for the existing PyPSA-BC stages."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from snakemake.utils import min_version, validate


min_version("9.0")
configfile: "config/workflow.yaml"
validate(config, "schemas/config.schema.yaml")

REPO = Path.cwd()
sys.path.insert(0, str((REPO / "src").resolve()))

from pypsa_bc.studies.cascade.scenarios import expand_scenarios


PYTHON = sys.executable
OUTPUT_ROOT = config["workflow"]["output_root"].rstrip("/")
RUN_ID = config["workflow"]["run_id"]
SCENARIO_DIR = f"{OUTPUT_ROOT}/scenarios/cases"
RUN_DIR = f"{OUTPUT_ROOT}/runs"
BASE_MODEL_DIR = f"{OUTPUT_ROOT}/base_model"
PREPARED_BASE_MODEL = f"{BASE_MODEL_DIR}/network_prepared.nc"
BASE_MODEL_BUILD_REPORT = f"{BASE_MODEL_DIR}/model_preparation.md"
BASE_MODEL_VALIDATION = f"{BASE_MODEL_DIR}/validation/network_structure.json"
SOLVED_BASE_MODEL = f"{BASE_MODEL_DIR}/network_solved.nc"
BASE_MODEL_SOLVE_SUMMARY = f"{BASE_MODEL_DIR}/solve_summary.json"
CASES = expand_scenarios(config)
CASE_IDS = [case["case_id"] for case in CASES]
RUNNABLE_CASE_IDS = [case["case_id"] for case in CASES if case["runnable"]]
CASE_FILES = [f"{SCENARIO_DIR}/{case_id}.yaml" for case_id in CASE_IDS]

ASSETS = [
    "data/processed_data/wind/existing/bc_ext_wind_assets.csv",
    "data/processed_data/solar/existing/bc_ext_solar_assets.csv",
    "data/processed_data/tpp/existing/bc_ext_tpp_assets.csv",
    "data/processed_data/hydro/existing/hydro_generation.csv",
    "data/processed_data/hydro/existing/hydro_reservoirs.csv",
    "data/processed_data/hydro/existing/hydro_cascade.csv",
    "data/downloaded_data/wind/turbine_dict.json",
]
PROFILES = [
    "data/processed_data/wind/existing/bc_ext_wind_ts.csv",
    "data/processed_data/solar/existing/bc_ext_solar_ts.csv",
    "data/processed_data/hydro/existing/bc_ext_ror_ts.csv",
    "data/processed_data/hydro/existing/bc_ext_reservoir_inflows.csv",
]
LOADS = [
    "data/processed_data/load/hourly_res.csv",
    "data/processed_data/load/hourly_csmi.csv",
]
MODEL_DATA = [
    "data/pypsa_data/wind.pickle",
    "data/pypsa_data/solar.pickle",
    "data/pypsa_data/tpp.pickle",
    "data/pypsa_data/ff_infra.pickle",
    "data/pypsa_data/hydro_reservoirs.pickle",
    "data/pypsa_data/hydro_ror.pickle",
    "data/pypsa_data/hydro_ror_water.pickle",
]


include: "rules/common.smk"


rule all:
    """Safe default: validate configuration and contracts without rebuilding data."""
    input:
        f"{OUTPUT_ROOT}/preflight.json"


rule preflight:
    input:
        config="config/workflow.yaml",
        schema="workflow/schemas/config.schema.yaml",
        script="workflow/scripts/workflow_preflight.py",
    output:
        f"{OUTPUT_ROOT}/preflight.json"
    log:
        f"logs/snakemake/preflight.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.workflow_preflight", "--config", input.config,
             "--output", output[0]],
            log[0],
        )


rule compile_scenarios:
    input:
        config="config/workflow.yaml",
        protocol="config/studies/chapter2_cascade.yaml",
        script="workflow/scripts/compile_scenarios.py",
    output:
        manifest=f"{SCENARIO_DIR}/scenario_manifest.csv",
        cases=CASE_FILES,
    log:
        "logs/snakemake/compile_scenarios.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.compile_scenarios", "--config", input.config,
             "--output-directory", SCENARIO_DIR],
            log[0],
        )


rule scenario_plan:
    input:
        f"{SCENARIO_DIR}/scenario_manifest.csv"


include: "rules/base_network.smk"


rule fetch_wind_inventory:
    input:
        config="config/data.yaml",
        script="workflow/scripts/fetch_inputs.py",
    output:
        "data/downloaded_data/wind/canada_turbines.xlsx"
    log:
        "logs/snakemake/fetch_wind_inventory.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.fetch_inputs", "--only", "can_turbines"],
            log[0],
        )


rule asset_preparation:
    """Stage 2: prepare hydro, wind, solar, and thermal asset inventories."""
    input:
        base=BASE_NETWORK,
        base_validation=BASE_NETWORK_VALIDATION_SUMMARY,
        wind_inventory="data/downloaded_data/wind/canada_turbines.xlsx",
        generators="data/downloaded_data/CODERS/data-pull/supply/generators.csv",
        generic="data/downloaded_data/CODERS/data-pull/supply/generation_generic.csv",
        hydro="data/downloaded_data/CODERS/data-pull/supply/existing_hydro.csv",
        hydro_topology="data/inventory/hydro_topology.csv",
        hydro_reservoirs="data/inventory/hydro_reservoirs.csv",
        generator_wup="data/inventory/custom/hydro_gen_wup_features.csv",
        reservoir_wup="data/inventory/custom/hydro_res_wup_features.csv",
        evidence="studies/chapter2/inputs/cascade_evidence_register.csv",
        schedules="studies/chapter2/inputs/release_schedules.csv",
        script="workflow/scripts/prepare_assets.py",
    output:
        ASSETS
    log:
        "logs/snakemake/02_asset_preparation.log"
    run:
        require_validation_pass(input.base_validation, "Base network")
        run_logged([PYTHON, "-m", "workflow.scripts.prepare_assets"], log[0])


rule profile_preparation:
    """Stage 3: prepare supply profiles and regional-district demand profiles."""
    input:
        assets=ASSETS,
        cutout="data/downloaded_data/cutout/BC_2021_2022.nc",
        basin_na="data/downloaded_data/HydroBASINS/hybas_na_lev12_v1c.shp",
        basin_arctic="data/downloaded_data/HydroBASINS_arctic/hybas_ar_lev12_v1c.shp",
        params="config/params.yaml",
        bch="data/downloaded_data/load/bc_hydro_load/BalancingAuthorityLoad2021.xls",
        ceei="data/downloaded_data/load/CEEI_2022.xlsx",
        boundaries="data/downloaded_data/GADM/gadm41_CAN_2.geojson",
        supply_script="workflow/scripts/prepare_profiles.py",
        load_script="workflow/scripts/prepare_load.py",
    output:
        PROFILES + LOADS
    log:
        supply="logs/snakemake/03a_supply_profile_preparation.log",
        demand="logs/snakemake/03b_demand_profile_preparation.log",
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.prepare_profiles", "--force-update"],
            log.supply,
        )
        run_logged(
            [PYTHON, "-m", "workflow.scripts.prepare_load", "--year",
             str(config["execution"]["year"])],
            log.demand,
        )


rule model_input_data_preparation:
    """Stage 4a: convert prepared tables and profiles to builder-ready objects."""
    input:
        base=BASE_NETWORK,
        assets=ASSETS,
        profiles=PROFILES,
        script="workflow/scripts/prepare_data_handover.py",
    output:
        MODEL_DATA
    log:
        "logs/snakemake/04a_model_input_data_preparation.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.prepare_data_handover", "--force-update"],
            log[0],
        )


rule prepared_inputs:
    input:
        BASE_NETWORK + ASSETS + PROFILES + LOADS + MODEL_DATA


rule model_file_preparation:
    """Stage 4b: assemble and export the unsolved PyPSA network file."""
    input:
        data=BASE_NETWORK + LOADS + MODEL_DATA,
        script="workflow/scripts/prepare_model_file.py",
    output:
        network=PREPARED_BASE_MODEL,
        report=BASE_MODEL_BUILD_REPORT,
    params:
        representation=config["base_model"]["reservoir_representation"],
        water_policy=config["base_model"]["water_policy"],
        release_multiplier=config["base_model"]["release_multiplier"],
    log:
        "logs/snakemake/04b_model_file_preparation.log"
    run:
        run_base_model_preparation(
            output.network,
            output.report,
            params.representation,
            params.water_policy,
            params.release_multiplier,
            log[0],
        )


rule network_validation:
    """Stage 5: validate the prepared network structure before any solve."""
    input:
        network=PREPARED_BASE_MODEL,
        script="workflow/scripts/validate_model_network.py",
    output:
        summary=BASE_MODEL_VALIDATION,
    log:
        "logs/snakemake/05_network_validation.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.validate_model_network",
             "--network", input.network, "--summary", output.summary],
            log[0],
        )


rule gate_1_inputs:
    input:
        protocol="config/studies/chapter2_cascade.yaml",
        prepared=BASE_NETWORK + ASSETS + PROFILES,
        schedule="studies/chapter2/inputs/release_schedules.csv",
        uncertainty="data/validation/chapter2/release_uncertainty_protocol.yaml",
        script="workflow/scripts/studies/chapter2/audit_inputs.py",
    output:
        summary="studies/chapter2/gate1/summary.json",
        report="studies/chapter2/gate1/gate1_report.md",
    log:
        "logs/snakemake/gate1.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.studies.chapter2.audit_inputs",
             "--protocol", input.protocol, "--repo-root", str(REPO)],
            log[0],
        )


rule gate_2_physics:
    input:
        constraints="src/pypsa_bc/studies/cascade/constraints.py",
        verification="src/pypsa_bc/studies/cascade/verification.py",
        script="workflow/scripts/studies/chapter2/verify_physics.py",
    output:
        summary="studies/chapter2/gate2/summary.json",
        report="studies/chapter2/gate2/gate2_report.md",
        cases="studies/chapter2/gate2/analytic_verification.csv",
    log:
        "logs/snakemake/gate2.log"
    run:
        run_logged([PYTHON, "-m", "workflow.scripts.studies.chapter2.verify_physics"], log[0])


rule gate_2_representations:
    input:
        reservoirs="data/pypsa_data/hydro_reservoirs.pickle",
        ror_water="data/pypsa_data/hydro_ror_water.pickle",
        topology="studies/chapter2/inputs/cascade_evidence_register.csv",
        schedules="studies/chapter2/inputs/release_schedules.csv",
        representation="src/pypsa_bc/studies/cascade/representation.py",
        script="workflow/scripts/studies/chapter2/audit_hydraulic_representations.py",
    output:
        summary="studies/chapter2/gate2/representation_verification.json",
        report="studies/chapter2/gate2/representation_verification.md",
        cases="studies/chapter2/gate2/representation_verification.csv",
    log:
        "logs/snakemake/gate2_representations.log"
    run:
        run_logged(
            [PYTHON, "-m",
             "workflow.scripts.studies.chapter2.audit_hydraulic_representations"],
            log[0],
        )


rule scientific_gates:
    input:
        "studies/chapter2/gate1/summary.json",
        "studies/chapter2/gate2/summary.json",
        "studies/chapter2/gate2/representation_verification.json",
        "studies/chapter2/gate2/release_uncertainty_verification.json",


rule solve_base_model:
    """Stage 6: solve only after structural and scientific validation pass."""
    input:
        network=PREPARED_BASE_MODEL,
        structural=BASE_MODEL_VALIDATION,
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation_gate="studies/chapter2/gate2/representation_verification.json",
        release_uncertainty_gate="studies/chapter2/gate2/release_uncertainty_verification.json",
        script="workflow/scripts/solve_model.py",
    output:
        network=SOLVED_BASE_MODEL,
        summary=BASE_MODEL_SOLVE_SUMMARY,
    log:
        "logs/snakemake/06_solve_base_model.log"
    run:
        run_base_model_solve(
            input.network,
            output.network,
            output.summary,
            [input.structural, input.gate1, input.gate2,
             input.representation_gate, input.release_uncertainty_gate],
            log[0],
        )


rule base_model_workflow:
    """Master rule: execute the complete, gated base-model chain."""
    input:
        network=SOLVED_BASE_MODEL,
        summary=BASE_MODEL_SOLVE_SUMMARY,


rule gate_2_release_uncertainty:
    input:
        reservoirs="data/pypsa_data/hydro_reservoirs.pickle",
        ror_water="data/pypsa_data/hydro_ror_water.pickle",
        topology="studies/chapter2/inputs/cascade_evidence_register.csv",
        schedules="studies/chapter2/inputs/release_schedules.csv",
        protocol="data/validation/chapter2/release_uncertainty_protocol.yaml",
        uncertainty="src/pypsa_bc/studies/cascade/uncertainty.py",
        script="workflow/scripts/studies/chapter2/audit_release_uncertainty.py",
    output:
        summary="studies/chapter2/gate2/release_uncertainty_verification.json",
        report="studies/chapter2/gate2/release_uncertainty_verification.md",
        cases="studies/chapter2/gate2/release_uncertainty_verification.csv",
    log:
        "logs/snakemake/gate2_release_uncertainty.log"
    run:
        run_logged(
            [PYTHON, "-m",
             "workflow.scripts.studies.chapter2.audit_release_uncertainty"],
            log[0],
        )


rule solve_scenario:
    input:
        case=f"{SCENARIO_DIR}/{{case}}.yaml",
        data=BASE_NETWORK + LOADS + MODEL_DATA,
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation_gate="studies/chapter2/gate2/representation_verification.json",
        release_uncertainty_gate="studies/chapter2/gate2/release_uncertainty_verification.json",
        script="workflow/scripts/run_scenario.py",
    output:
        network=f"{RUN_DIR}/{{case}}/network.nc",
        report=f"{RUN_DIR}/{{case}}/build_model_report.md",
    log:
        f"logs/snakemake/solve_{{case}}.log"
    wildcard_constraints:
        case="|".join(re.escape(case_id) for case_id in RUNNABLE_CASE_IDS)
    run:
        run_configured_scenario(
            input.case,
            output.network,
            output.report,
            input.gate1,
            input.gate2,
            input.representation_gate,
            input.release_uncertainty_gate,
            log[0],
        )


rule solve_all_implemented:
    input:
        expand(f"{RUN_DIR}/{{case}}/network.nc", case=RUNNABLE_CASE_IDS)


rule visual_report:
    input:
        network=f"{RUN_DIR}/{{case}}/network.nc",
        script="workflow/scripts/build_visual_report.py",
    output:
        f"{RUN_DIR}/{{case}}/vis/network_visual_report.html"
    log:
        f"logs/snakemake/report_{{case}}.log"
    wildcard_constraints:
        case="|".join(re.escape(case_id) for case_id in RUNNABLE_CASE_IDS)
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.build_visual_report", "--network", input.network,
             "--vis-dir", f"{RUN_DIR}/{wildcards.case}/vis"],
            log[0],
        )


rule reports_all_implemented:
    input:
        expand(
            f"{RUN_DIR}/{{case}}/vis/network_visual_report.html",
            case=RUNNABLE_CASE_IDS,
        )
