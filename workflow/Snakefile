rule fetch_bc_hydro_annual_validation:
    """Pin the official BC Hydro annual report used for boundary triangulation."""
    input:
        script="workflow/scripts/fetch_bc_hydro_annual_validation.py",
    output:
        pdf=BC_HYDRO_ANNUAL_REPORT,
        manifest=BC_HYDRO_ANNUAL_REPORT_MANIFEST,
    log:
        "logs/snakemake/fetch_bc_hydro_annual_validation.log"
    run:
