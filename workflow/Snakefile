"""Non-invasive Snakemake orchestration for the existing PyPSA-BC stages."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from snakemake.utils import min_version, validate


min_version("9.0")
configfile: "config/workflow.yaml"
validate(config, "schemas/config.schema.yaml")

REPO = Path.cwd()
sys.path.insert(0, str((REPO / "src").resolve()))

from pypsa_bc.studies.cascade.scenarios import expand_scenarios


PYTHON = sys.executable
