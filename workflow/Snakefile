rule solve_base_model:
    """Stage 6: solve only after structural and scientific validation pass."""
    input:
        network=PREPARED_BASE_MODEL,
        structural=BASE_MODEL_VALIDATION,
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation_gate="studies/chapter2/gate2/representation_verification.json",
        release_uncertainty_gate="studies/chapter2/gate2/release_uncertainty_verification.json",
        storage_uncertainty_gate="studies/chapter2/gate2/storage_uncertainty_verification.json",
        external_boundary_gate="studies/chapter2/gate2/external_boundary_verification.json",
        script="workflow/scripts/solve_model.py",
    output:
        network=SOLVED_BASE_MODEL,
        summary=BASE_MODEL_SOLVE_SUMMARY,
    log:
        "logs/snakemake/06_solve_base_model.log"
    run:
        run_base_model_solve(
            input.network,
            output.network,
            output.summary,
            [input.structural, input.gate1, input.gate2,
             input.representation_gate, input.release_uncertainty_gate,
             input.storage_uncertainty_gate, input.external_boundary_gate],
            log[0],
        )


rule base_model_workflow:
    """Master rule: execute the complete, gated base-model chain."""
    input:
        network=SOLVED_BASE_MODEL,
        summary=BASE_MODEL_SOLVE_SUMMARY,


rule rolling_horizon_pilot:
    """Hydro-first feasibility pilot with explicit chronological state transfer."""
    input:
        network=PREPARED_BASE_MODEL,
        structural=BASE_MODEL_VALIDATION,
        gate1="studies/chapter2/gate1/summary.json",
        gate2="studies/chapter2/gate2/summary.json",
        representation_gate="studies/chapter2/gate2/representation_verification.json",
        release_uncertainty_gate="studies/chapter2/gate2/release_uncertainty_verification.json",
        storage_uncertainty_gate="studies/chapter2/gate2/storage_uncertainty_verification.json",
        external_boundary_gate="studies/chapter2/gate2/external_boundary_verification.json",
        script="workflow/scripts/solve_rolling_horizon.py",
    output:
        summary=ROLLING_SUMMARY,
        audit=ROLLING_AUDIT,
        windows=ROLLING_WINDOW_FILES,
    params:
        cfg=config["rolling_horizon"],
    log:
        "logs/snakemake/06_rolling_horizon_pilot.log"
    run:
        for gate_path in [
            input.structural,
            input.gate1,
            input.gate2,
            input.representation_gate,
            input.release_uncertainty_gate,
            input.storage_uncertainty_gate,
            input.external_boundary_gate,
        ]:
            require_validation_pass(gate_path, "Rolling-horizon prerequisite")
        arguments = [
            PYTHON, "-m", "workflow.scripts.solve_rolling_horizon",
            "--network", input.network,
            "--output-root", ROLLING_DIR,
            "--summary", output.summary,
            "--window-hours", str(params.cfg["window_hours"]),
            "--lookahead-hours", str(params.cfg["lookahead_hours"]),
            "--initial-storage-fraction", str(params.cfg["initial_storage_fraction"]),
            "--time-limit-seconds", str(params.cfg["time_limit_seconds"]),
            "--max-windows", str(params.cfg["max_windows"]),
            "--closure-window-hours", str(params.cfg["closure_window_hours"]),
        ]
        if params.cfg["enforce_annual_closure"]:
            arguments.append("--enforce-annual-closure")
        run_logged(arguments, log[0])


rule rolling_horizon_diagnostics:
    """Audit scientific credibility of committed rolling-horizon hours."""
    input:
        source_network=PREPARED_BASE_MODEL,
        rolling_summary=ROLLING_SUMMARY,
        rolling_audit=ROLLING_AUDIT,
        windows=ROLLING_WINDOW_FILES,
        script="workflow/scripts/studies/chapter2/audit_rolling_results.py",
        diagnostics="src/pypsa_bc/studies/rolling_diagnostics.py",
    output:
        summary=ROLLING_DIAGNOSTIC_SUMMARY,
        report=ROLLING_DIAGNOSTIC_REPORT,
        dispatch=f"{ROLLING_DIAGNOSTIC_DIR}/committed_dispatch.csv",
        external=f"{ROLLING_DIAGNOSTIC_DIR}/external_interchange_fidelity.csv",
        backstop=f"{ROLLING_DIAGNOSTIC_DIR}/backstop_by_region.csv",
        lines=f"{ROLLING_DIAGNOSTIC_DIR}/line_utilization.csv",
        storage=f"{ROLLING_DIAGNOSTIC_DIR}/reservoir_storage_trajectory.csv",
        storage_bounds=f"{ROLLING_DIAGNOSTIC_DIR}/reservoir_storage_bounds.csv",
        releases=f"{ROLLING_DIAGNOSTIC_DIR}/release_compliance.csv",
        dispatch_svg=f"{ROLLING_DIAGNOSTIC_DIR}/figure_committed_dispatch.svg",
        dispatch_png=f"{ROLLING_DIAGNOSTIC_DIR}/figure_committed_dispatch.png",
        storage_svg=f"{ROLLING_DIAGNOSTIC_DIR}/figure_reservoir_storage.svg",
        storage_png=f"{ROLLING_DIAGNOSTIC_DIR}/figure_reservoir_storage.png",
        lines_svg=f"{ROLLING_DIAGNOSTIC_DIR}/figure_line_utilization.svg",
        lines_png=f"{ROLLING_DIAGNOSTIC_DIR}/figure_line_utilization.png",
    params:
        backstop_tolerance=config["rolling_horizon"]["publication_backstop_share_tolerance"],
    log:
        "logs/snakemake/07_rolling_horizon_diagnostics.log"
    run:
        run_logged(
            [
                PYTHON, "-m",
                "workflow.scripts.studies.chapter2.audit_rolling_results",
                "--result-directory", ROLLING_DIR,
                "--source-network", input.source_network,
                "--output-directory", ROLLING_DIAGNOSTIC_DIR,
                "--backstop-share-tolerance", str(params.backstop_tolerance),
            ],
            log[0],
        )


