rule all:
    """Safe default: validate configuration and contracts without rebuilding data."""
    input:
        f"{OUTPUT_ROOT}/preflight.json"


rule preflight:
    input:
        config="config/workflow.yaml",
        schema="workflow/schemas/config.schema.yaml",
        script="workflow/scripts/workflow_preflight.py",
    output:
        f"{OUTPUT_ROOT}/preflight.json"
    log:
        f"logs/snakemake/preflight.log"
    run:
        run_logged(
            [PYTHON, "-m", "workflow.scripts.workflow_preflight", "--config", input.config,
             "--output", output[0]],
            log[0],
        )


