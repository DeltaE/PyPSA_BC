rule prepared_inputs:
    input:
        BASE_NETWORK + ASSETS + PROFILES + LOADS + MODEL_DATA


rule model_file_preparation:
    """Stage 4b: assemble and export the unsolved PyPSA network file."""
    input:
        data=(
            BASE_NETWORK + LOADS + MODEL_DATA + EXTERNAL_BOUNDARY_DATA
            + [STATCAN_GENERATION, BC_HYDRO_STATION_EVIDENCE, BC_HYDRO_STATION_MAPPING]
        ),
        script="workflow/scripts/prepare_model_file.py",
    output:
        network=PREPARED_BASE_MODEL,
        report=BASE_MODEL_BUILD_REPORT,
    params:
        representation=config["base_model"]["reservoir_representation"],
        water_policy=config["base_model"]["water_policy"],
        storage_policy=config["base_model"]["storage_policy"],
        external_boundary_policy=config["base_model"]["external_boundary_policy"],
        network_flow_formulation=config["base_model"]["network_flow_formulation"],
        generation_calibration_policy=config["base_model"]["generation_calibration_policy"],
        ror_dispatch_policy=config["base_model"]["ror_dispatch_policy"],
        named_station_capacity_policy=config["base_model"]["named_station_capacity_policy"],
        release_multiplier=config["base_model"]["release_multiplier"],
    log:
        "logs/snakemake/04b_model_file_preparation.log"
    run:
        run_base_model_preparation(
            output.network,
            output.report,
            params.representation,
            params.water_policy,
            params.storage_policy,
            params.external_boundary_policy,
            params.network_flow_formulation,
            params.release_multiplier,
            log[0],
        )


