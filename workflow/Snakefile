rule profile_preparation:
    """Stage 3: prepare supply profiles and regional-district demand profiles."""
    input:
        assets=ASSETS,
        asset_validation=ASSET_VALIDATION_SUMMARY,
        cutout="data/downloaded_data/cutout/BC_2021_2022.nc",
        basin_na="data/downloaded_data/HydroBASINS/hybas_na_lev12_v1c.shp",
        basin_arctic="data/downloaded_data/HydroBASINS_arctic/hybas_ar_lev12_v1c.shp",
        params="config/params.yaml",
        bch="data/downloaded_data/load/bc_hydro_load/BalancingAuthorityLoad2021.xls",
        ceei="data/downloaded_data/load/CEEI_2022.xlsx",
        boundaries="data/downloaded_data/GADM/gadm41_CAN_2.geojson",
        supply_script="workflow/scripts/prepare_profiles.py",
        load_script="workflow/scripts/prepare_load.py",
    output:
        PROFILES + LOADS
    log:
        supply="logs/snakemake/03a_supply_profile_preparation.log",
        demand="logs/snakemake/03b_demand_profile_preparation.log",
    run:
        require_validation_pass(input.asset_validation, "Assets")
        run_logged(
            [PYTHON, "-m", "workflow.scripts.prepare_profiles", "--force-update"],
            log.supply,
        )
        run_logged(
            [PYTHON, "-m", "workflow.scripts.prepare_load", "--year",
             str(config["execution"]["year"])],
            log.demand,
        )


